return {
    { q = "Dex did their best to look sympathetic, which is what they wanted to be, rather than lost, which is what they were", a = "Becky Chambers", b = "A Psalm for the Wild-Built" },
    { q = "Six weeks ago I was murdered, an act which the police, for reasons of their own, have chosen to regard as suicide. Since the murderers ultimately failed I can only assume that they will try again and, in view of the police attitude, they may well succeed.", a = "Richard Morgan", b = "Altered Carbon" },
    { q = "Coming back from the dead sometimes makes you feel that way. Or maybe it was just arrogance", a = "Richard Morgan", b = "Altered Carbon" },
    { q = "It didn’t look like much, impact-resistant casing streaked with blood and barely the size of a cigarette butt with the twisted filaments of the microjacks protruding stiffly from one end. I could see how the Catholics might not want to believe this was the receptacle of the human soul", a = "Richard Morgan", b = "Altered Carbon" },
    { q = "They’re not human, they deal with humanity the way you and I deal with insect life.", a = "Richard Morgan", b = "Altered Carbon" },
    { q = "Someone had programmed a laugh into the robot. It sounded like a fat man drowning in syrup", a = "Richard Morgan", b = "Altered Carbon" },
    { q = "Economic crisis. You know how it is. One day you own a house, your sleeve policy’s paid up, the next you’re on the street looking at a single lifespan", a = "Richard Morgan", b = "Altered Carbon" },
    { q = "And after that, well, then we get into the ethereal realm of things like promises and my word", a = "Richard Morgan", b = "Altered Carbon" },
    { q = "Don’t piss in my head, friend. I don’t like it.”", a = "Richard Morgan", b = "Altered Carbon" },
    { q = "Death, where is thy sting", a = "Richard Morgan", b = "Altered Carbon" },
    { q = "The personal, as every one’s so fucking fond of saying, is political. So if some idiot politician, some power player, tries to execute policies that harm you or those you care about, TAKE IT PERSONALLY. Get angry. The Machinery of Justice will not serve you here—it is slow and cold, and it is theirs, hardware and soft-. Only the little people suffer at the hands of Justice; the creatures of power slide out from under with a wink and a grin. If you want justice, you will have to claw it from them. Make it PERSONAL. Do as much damage as you can. GET YOUR MESSAGE ACROSS", a = "Richard Morgan", b = "Altered Carbon" },
    { q = "An electronic demon, a malignant spirit that dwelled in altered carbon and emerged only to possess flesh and wreak havoc", a = "Richard Morgan", b = "Altered Carbon" },
    { q = "Kill them along the way, but count your bullets, for there are more worthy targets.” Kadmin chuckled deep", a = "Richard Morgan", b = "Altered Carbon" },
    { q = "Course, with Understanding Day, the whales were suddenly big money for anyone who could talk to them. You know they’ve told us almost as much about the Martians as four centuries of archaeologues on Mars itself. Christ, they remember them coming here. Race memory, that is", a = "Richard Morgan", b = "Altered Carbon" },
    { q = "That’s what an Envoy is, Curtis. A reassembled human. An artifice", a = "Richard Morgan", b = "Altered Carbon" },
    { q = "The human eye is a wonderful device,’ ” I quoted from Poems and Other Prevarications absently. “ ‘With a little effort, it can fail to see even the most glaring injustice", a = "Richard Morgan", b = "Altered Carbon" },
    { q = "I feel like a behaviourist who has designed her rat’s maze poorly", a = "Richard Morgan", b = "Altered Carbon" },
    { q = "But thought, like the dawn, was inevitable and it found me, with the dawn, on a set of white stone steps that led down into murky water", a = "Richard Morgan", b = "Altered Carbon" },
    { q = "He peered out at us with a lack of focus I’d seen before on datarats when they’d been cruising the stacks for too long. Jack-happy.", a = "Richard Morgan", b = "Altered Carbon" },
    { q = "I looked at the gleam on the needle, mind slicing the facts like vegetables for a bowl of ramen", a = "Richard Morgan", b = "Altered Carbon" },
    { q = "We’re not dealt in, we’re thrownin, and after that it’s just about keeping your head above water", a = "Richard Morgan", b = "Altered Carbon" },
    { q = "Machines cost money to build. Raw materials cost money to extract. But people?” She made a tiny spitting sound. “You can always get some more people. They reproduce like cancer cells, whether you want them or not", a = "Richard Morgan", b = "Altered Carbon" },
    { q = "When they ask how I died,” I said, “tell them: still angry.", a = "Richard Morgan", b = "Altered Carbon" },
    { q = "But not everyone has dreams. Some people just are, the way that trees and rocks and rivers are just there without a reason, the rest of the world moving around them", a = "Kylie Lee Baker", b = "Bat Eater and Other Names for Cora Zeng" },
    { q = "Delilah tosses words out easily, dandelion parachutes carried about by the wind.", a = "Kylie Lee Baker", b = "Bat Eater and Other Names for Cora Zeng" },
    { q = "But everything sloughs off Cora like dead skin because she is not the kind of person who creates things, who makes a mark on the world. She is an echo, quieter and quieter until she’s nothing at all", a = "Kylie Lee Baker", b = "Bat Eater and Other Names for Cora Zeng" },
    { q = "A soft and rancid breeze sighs through it, like it is the maw of some massive creature", a = "Kylie Lee Baker", b = "Bat Eater and Other Names for Cora Zeng" },
    { q = "It’s that you’re asking me to believe in folktales when I don’t believe in anything at all", a = "Kylie Lee Baker", b = "Bat Eater and Other Names for Cora Zeng" },
    { q = "Everything hurts. Is that rude of me? Everything hurts, always. Sorrow, vengeance, even joy. Everything’s got teeth on it", a = "Keith Rosson", b = "Coffin Moon" },
    { q = "flashlight", a = "Keith Rosson", b = "Coffin Moon" },
    { q = "The master is a person of an excellent disposition and is remarkable in the ship for his gentleness and the mildness of his discipline.", a = "Mary Shelley, Siv Jansson", b = "Frankenstein" },
    { q = "The master is a person of an excellent disposition and is remarkable in the ship for his gentleness and the mildness of his discipline.", a = "Mary Wollstonecraft Shelley", b = "Frankenstein; Or, The Modern Prometheus" },
    { q = "Wild that a country that doesn’t even exist anymore can fuck up our language so much", a = "Beth Revis", b = "Full Speed to a Crash Landing" },
    { q = "You can do everything right, try to be good, try to do good, and sometimes it won’t matter. Your O-ring gets a crack in it, and you die before you have time to panic", a = "Beth Revis", b = "Full Speed to a Crash Landing" },
    { q = "perhaps the world will be reminded of its responsibilities. It will be recognized that, as a people, we never forgot. Our memory reaches back through recorded history. The memory book lies open, and the hand still writes", a = "Neal Bascomb", b = "Hunting Eichmann" },
    { q = "For the first time in history the Jews will judge their assassins, and for the first time the world will hear the full story of the edict of annihilation against an entire people. Everything depends on the action we are about to take.", a = "Neal Bascomb", b = "Hunting Eichmann" },
    { q = "Adolf Eichmann was now a prisoner of the Jewish people", a = "Neal Bascomb", b = "Hunting Eichmann" },
    { q = "Lee’s anger always burned through his blood and gnawed at his bones and felt like it would eat him alive, but no one else.", a = "Kylie Lee Baker", b = "Japanese Gothic" },
    { q = "That this goddess should be married to the gnome sitting in the study was the sort of thing that bolsters your faith in Money", a = "Philip Kerr", b = "March Violets" },
    { q = "I’ll bet she could breastfeed the entire Hitler Youth and still have milk enough left for Hermann’s breakfast.’", a = "Philip Kerr", b = "March Violets" },
    { q = "In my experience you can never flatter any woman too much, just as you can never give a dog too many biscuits", a = "Philip Kerr", b = "March Violets" },
    { q = "If he was a member of the human race at all, Neumann was its least attractive specimen. His eyebrows, twitching and curling like two poisoned caterpillars, were joined together by an irregular scribble of poorly matched hair.", a = "Philip Kerr", b = "March Violets" },
    { q = "Iffy,” he said, “it’s all looking very iffy tonight", a = "William Gibson", b = "Neuromancer" },
    { q = "And Ratz was there, and Linda Lee, Wage and Lonny Zone, a hundred faces from the neon forest, sailors and hustlers and whores, where the sky is poisoned silver, beyond chain link and the prison of the skull", a = "William Gibson", b = "Neuromancer" },
    { q = "These withered bodies had long forgotten the bitter taste of tears", a = "Elie Wiesel, François Mauriac, Stella Rodway", b = "Night" },
    { q = "The ghetto was ruled by neither German nor Jew; it was ruled by delusion", a = "Elie Wiesel, François Mauriac, Stella Rodway", b = "Night" },
    { q = "Monday went by like a small summer cloud, like a dream in the first hours of dawn", a = "Elie Wiesel, François Mauriac, Stella Rodway", b = "Night" },
    { q = "Man is too insignificant, too limited, to even try to comprehend God’s mysterious ways. But what can someone like myself do? I’m neither a sage nor a just man. I am not a saint. I’m a simple creature of flesh and bone. I suffer hell in my soul and my flesh. I also have eyes and I see what is being done here. Where is God’s mercy? Where’s God? How can I believe, how can anyone believe in this God of Mercy?”", a = "Elie Wiesel, François Mauriac, Stella Rodway", b = "Night" },
    { q = "The last night in Buna. Once more, the last night. The last night at home, the last night in the ghetto, the last night in the cattle car, and, now, the last night in Buna. How much longer would our lives be lived from one “last night” to the next?", a = "Elie Wiesel, François Mauriac, Stella Rodway", b = "Night" },
    { q = "THE BELOVED OBJECTS that we had carried with us from place to place were now left behind in the wagon and, with them, finally, our illusions", a = "Elie Wiesel, François Mauriac, Stella Rodway", b = "Night" },
    { q = "The darkness enveloped us. All I could hear was the violin, and it was as if Juliek’s soul had become his bow. He was playing his life. His whole being was gliding over the strings. His unfulfilled hopes. His charred past, his extinguished future. He played that which he would never play again.", a = "Elie Wiesel, François Mauriac, Stella Rodway", b = "Night" },
    { q = "an eerily poignant little corpse", a = "Elie Wiesel, François Mauriac, Stella Rodway", b = "Night" },
    { q = "knew that I was no longer arguing with him but with Death itself, with Death that he had already chosen.", a = "Elie Wiesel, François Mauriac, Stella Rodway", b = "Night" },
    { q = "In another glimpse I saw a woman twisting biscuits into her rectum, presumably as a capacious storage for later", a = "Michael S.A. Graziano", b = "The Divine Farce" },
    { q = "hundred", a = "Andrew Mayne", b = "The Girl Beneath the Sea" },
    { q = "part, the water is about fifteen feet deep. It’s clearer than usual, and the sun is out, which me", a = "Andrew Mayne", b = "The Girl Beneath the Sea" },
    { q = "It isn’t running away they’re afraid of. We wouldn’t get far. It’s those other escapes, the ones you can open in yourself, given a cutting edge.", a = "Margaret Atwood", b = "The Handmaid's Tale" },
    { q = "Apart from these details, this could be a college guest room, for the less distinguished visitors; or a room in a rooming house, of former times, for ladies in reduced circumstances. That is what we are now. The circumstances have been reduced; for those of us who still have circumstances.", a = "Margaret Atwood", b = "The Handmaid's Tale" },
    { q = "Their faces were the way women’s faces are when they’ve been talking about you behind your back and they think you’ve heard: embarrassed, but also a little defiant, as if it were their right", a = "Margaret Atwood", b = "The Handmaid's Tale" },
    { q = "It isn’t the sort of thing you ask questions about, because the answers are not usually answers you want to know.", a = "Margaret Atwood", b = "The Handmaid's Tale" },
    { q = "Though at that time men and women tried each other on, casually, like suits, rejecting whatever did not fit", a = "Margaret Atwood", b = "The Handmaid's Tale" },
    { q = "My self is a thing I must now compose, as one composes a speech", a = "Margaret Atwood", b = "The Handmaid's Tale" },
    { q = "I don’t want a man around, what use are they except for ten seconds’ worth of half babies. A man is just a woman’s strategy for making other women.", a = "Margaret Atwood", b = "The Handmaid's Tale" },
    { q = "He was an amateur naturalist, fond of birds and animals but not of humanity in general.", a = "Richard Preston", b = "The Hot Zone" },
    { q = "If those Nazis can fly back and forth between here and Mars, why can't they get television going?", a = "Philip K. Dick", b = "The Man In The High Castle" },
    { q = "The universe will never be extinguished because just when the darkness seems to have smothered all, to be truly transcendent, the new seeds of light are reborn in the very depths", a = "Philip K. Dick", b = "The Man In The High Castle" },
    { q = "How does the human race survive past one generation? How do parents not just eat their children?", a = "Dennis E. Taylor", b = "We Are Legion" },
    { q = "The officers shout in their officer language for the inhuman monstrosity to stop, to lie down and put its horribly inhuman hands on its head.", a = "Nat Cassidy", b = "When the Wolf Comes Home" },
    { q = "A man with knives for fingers and a face like ground beef.", a = "Nat Cassidy", b = "When the Wolf Comes Home" },
    { q = "No one will be spared when the wolf comes home.", a = "Nat Cassidy", b = "When the Wolf Comes Home" },
    { q = "while Mona sits in her room with a cooch so dusty it would take one of those Mary Poppins chimney sweepers to clear all the bats out.", a = "Nat Cassidy", b = "When the Wolf Comes Home" },
    { q = "She tries not to call attention to herself, tries to slow her gait and not appear like she’s a woman beset by a cloud of bees.", a = "Nat Cassidy", b = "When the Wolf Comes Home" },
    { q = "he dies feeling the guts he always wished he had slide out onto the ground.", a = "Nat Cassidy", b = "When the Wolf Comes Home" },
    { q = "She falls back on the couch, dead, before her screams finish passing through her vocal cords. Adelle looks out at what Mona saw, and her screams join her friend’s.", a = "Nat Cassidy", b = "When the Wolf Comes Home" },
    { q = "At another point, it’s a giant, naked infant, and it pisses something that looks like cartoon rainbows, only the colorful arcs burn whatever they touch like acid", a = "Nat Cassidy", b = "When the Wolf Comes Home" },
    { q = "When my brain begins to reel from my literary labors, I make an occasional cheese dip.", a = "John Kennedy Toole", b = "A Confederacy of Dunces" },
    { q = "Outside of the city limits the heart of darkness, the true wasteland begins.", a = "John Kennedy Toole", b = "A Confederacy of Dunces" },
    { q = "Canned food is a perversion,\" Ignatius said. \"I suspect that it is ultimately very damaging to the soul.", a = "John Kennedy Toole", b = "A Confederacy of Dunces" },
    { q = "In the Navy I was a cop and in the cops I was a cop.", a = "Jonathan Ames", b = "A Man Named Doll" },
    { q = "For lo the shadows of a gaol untold, Do grow about our days now many fold.", a = "Haruki Murakami", b = "A Wild Sheep Chase" },
    { q = "Time really is one big continuous cloth, no? We habitually cut out pieces of time to fit us...", a = "Haruki Murakami", b = "A Wild Sheep Chase" },
    { q = "Nothing special, really. It just felt like there was this sheep inside me.", a = "Haruki Murakami", b = "A Wild Sheep Chase" },
    { q = "If I wanted to suck vile fluids out of a flaccid and indifferent tube, I'd have stayed on Earth with my husband.", a = "James S. A. Corey", b = "Abaddon's Gate" },
    { q = "The mech hadn't been designed for violence, but it was suited for it. That made her and it the same.", a = "James S. A. Corey", b = "Abaddon's Gate" },
    { q = "Protein, oil, water, and vegetable paste. Sometimes it had a nearly homeopathic dose of curry.", a = "James S. A. Corey", b = "Abaddon's Gate" },
    { q = "We'll get out of here, back into the solar system where I'm rich and a thousand bucks doesn't matter, or we won't get out and nothing will matter.", a = "James S. A. Corey", b = "Abaddon's Gate" },
    { q = "He walked out on the prairie and stood holding his hat like some supplicant to the darkness over them all and he stood there for a long time.", a = "Cormac McCarthy", b = "All the Pretty Horses" },
    { q = "If you want to go fast, go alone. If you want to go far, go together.", a = "Rick Stanton", b = "Aquanaut" },
    { q = "We're not in space—we're on the moon. I mean, technically we're 'in space' but so is London.", a = "Andy Weir", b = "Artemis" },
    { q = "It's not like people go to school for it. No one sets out to be an editor. It's something that happens to you, like jaundice or falling down a well.", a = "Harry Dolan", b = "Bad Things Happen" },
    { q = "Sproule sat where the tracks crossed and looked out from the great caves in his skull where his eyes lay.", a = "Cormac McCarthy", b = "Blood Meridian" },
    { q = "It is not necessary, he said, that the principals here be in possession of the facts concerning their case, for their acts will ultimately accommodate history with or without their understanding.", a = "Cormac McCarthy", b = "Blood Meridian" },
    { q = "They'd been skinned and I can tell ye it does very little for a man's appearance.", a = "Cormac McCarthy", b = "Blood Meridian" },
    { q = "They rode in a narrow enfilade along a trail strewn with the dry round turds of goats.", a = "Cormac McCarthy", b = "Blood Meridian" },
    { q = "The man who believes that the secrets of the world are forever hidden lives in mystery and fear.", a = "Cormac McCarthy", b = "Blood Meridian" },
    { q = "By pushing a swizzle stick up his staff.", a = "Mary Roach", b = "Bonk" },
    { q = "Wallen's analysis of Bonaparte's data... hopes tall women might be relieved by an anatomical explanation.", a = "Mary Roach", b = "Bonk" },
    { q = "My organization gave some thought to this. What couple would do this? Who wanted to pay the three or four thousand dollars to fly them both to London?", a = "Mary Roach", b = "Bonk" },
    { q = "Lack of desire (HSDD) is the most common of women's sexual complaints. (Monkeys will be involved. Do not change the channel.)", a = "Mary Roach", b = "Bonk" },
    { q = "I can recall, many years ago, being told that a clitoris is a vestigial penis. The feminist in me... took umbrage.", a = "Mary Roach", b = "Bonk" },
    { q = "The spinal reflex known as the Lazarus sign has been spooking doctors for centuries.", a = "Mary Roach", b = "Bonk" },
    { q = "There were seventy-five rats. They wore their pants for one year... polyester or blends had sex less often than cotton or wool.", a = "Mary Roach", b = "Bonk" },
    { q = "Did foot-strengthening drills and special walks in bare feet. Bit by bit, Webb watched his feet transform before his eyes. \"I was a size twelve and flat-footed, and now I'm a nine or ten.\"", a = "Christopher McDougall", b = "Born to Run" },
    { q = "Wyoming, and the former fitness director for the University of Colorado Health Sciences Center, Eric's specialty is tearing endurance...", a = "Christopher McDougall", b = "Born to Run" },
    { q = "Convinced that he'd rediscovered an ancient art, Ken named his style Evolution Running... \"Chi Running\"... \"POSE Method.\"", a = "Christopher McDougall", b = "Born to Run" },
    { q = "The mechanic, Amos Burton. Implicated in several murders, indicted, never tried. Took an elective vasectomy the day he was legally old enough to do so. Naomi.", a = "James S. A. Corey", b = "Caliban's War" },
    { q = "It was deeply a part of Lee's kindness and understanding that man's right to kill himself is inviolable, but sometimes a friend can make it unnecessary.", a = "John Steinbeck", b = "Cannery Row" },
    { q = "He can kill anything for need but he could not even hurt a feeling for pleasure.", a = "John Steinbeck", b = "Cannery Row" },
    { q = "The things we admire in men—kindness and generosity, openness, honesty, understanding and feeling—are the concomitants of failure in our system. And those traits we detest—sharpness, greed, acquisitiveness, meanness, egotism and self-interest—are the traits of success. And while men admire the quality of the first, they love the produce of the second.", a = "John Steinbeck", b = "Cannery Row" },
    { q = "She sat stark naked on the ground and watched him go, calling various names after him, none his.", a = "Cormac McCarthy", b = "Child of God" },
    { q = "They looked like constipated gargoyles.", a = "Cormac McCarthy", b = "Child of God" },
    { q = "Any time you feel froggy, jump.", a = "Cormac McCarthy", b = "Child of God" },
    { q = "Whatever voice spoke him was no demon but some old shed self that came yet from time to time in the name of sanity, a hand to gentle him back from the rim of his disastrous wrath.", a = "Cormac McCarthy", b = "Child of God" },
    { q = "He had resolved himself to ride on for he could not turn back and the world that day was as lovely as any day that ever was and he was riding to his death.", a = "Cormac McCarthy", b = "Child of God" },
    { q = "Later,\" Amos said, \"when you're wishing we had this stuff, I am going to be merciless in my mockery. And then we'll die.", a = "James S. A. Corey", b = "Cibola Burn" },
    { q = "You can order the sun to come up if you time it right.", a = "James S. A. Corey", b = "Cibola Burn" },
    { q = "Sir, if I ever hung somebody, he wouldn't go around bitchin' about it the next day.", a = "Tom Clancy", b = "Clear and Present Danger" },
    { q = "Myself, I'd rather know every whore,\" Gus said. \"You can have a lot more fun with whores than you can with governors.", a = "Larry McMurtry", b = "Dead Man's Walk" },
    { q = "Several of the old men were watching Gus, as if he were a new kind of human, a kind their experience had not prepared them for.", a = "Larry McMurtry", b = "Dead Man's Walk" },
    { q = "We believe we have fulfilled our journalistic obligations by relaying this news without commentary. We will do the same each day, but we refuse to glorify an affair which is repugnant from so many points of view.", a = "David King", b = "Death in the City of Light" },
    { q = "So, as you would imagine, I grew up exuberant in body but with a nervy, craving mind. It was wanting something more, something tangible. It sought for reality intensely, always if it were not there. But you see at once what I do. I climb.", a = "Jon Krakauer", b = "Eiger Dreams" },
    { q = "She doesn't experience temporary retardation in your presence, as you do in hers.", a = "Ron Currie Jr.", b = "Everything Matters!" },
    { q = "Like Genghis Khan on an iron horse, a monster steed with a fiery anus, flat out through the eye of a beer can and up your daughter's leg with no quarter asked and none given.", a = "Hunter S. Thompson", b = "Hell's Angels" },
    { q = "We condemn them,\" says an AMA director. \"They'd be condemned if they rode horses, mules, surfboards, bicycles or skateboards. Regretfully, they picked motorcycles.", a = "Hunter S. Thompson", b = "Hell's Angels" },
    { q = "Perhaps the Angels will one day follow the Freemasons into bourgeois senility, but by then some other group will be making outrage headlines: a Hovercraft gang, or maybe some once-bland fraternal group tooling up even now for whatever the future might force on them.", a = "Hunter S. Thompson", b = "Hell's Angels" },
    { q = "This is one of those situations where there isn't a right or wrong answer. You just have to pick one and convince yourself later that it was the best decision at that time.", a = "Jeneva Rose", b = "Home Is Where the Bodies Are" },
    { q = "Blessed be the truly unwise, for they bring hope to those obligated to pursue them. Blessed be those of dim understanding, for by their very ignorance they bring light to those who labor in darkness.", a = "David Simon", b = "Homicide" },
    { q = "He may successfully accumulate, but he does not accumulate success, for he is his own enemy and is kept from truly enjoying his achievements.", a = "Truman Capote", b = "In Cold Blood" },
    { q = "Didn't want to harm the man. I thought he was a very nice gentleman. Soft-spoken. I thought so right up to the moment I cut his throat.", a = "Truman Capote", b = "In Cold Blood" },
    { q = "If ever I do get out of here alive, I mean over the walls and clear out—well, maybe nobody will know where Andy went, but they'll sure hell know where Andy's been.", a = "Truman Capote", b = "In Cold Blood" },
    { q = "The lights in the street outside came on, and the neon restaurant sign on the corner jerked on and off, exploding its hard red light in the air.", a = "John Steinbeck", b = "In Dubious Battle" },
    { q = "Humidity feels like hundreds of strangers touching me.", a = "Douglas Coupland", b = "JPod" },
    { q = "The girl's talk was as fast and meaningless as a leaking seal, and her father responded with grunts and nods at more or less appropriate moments.", a = "James S. A. Corey", b = "Leviathan Wakes" },
    { q = "Octavia Muss was originally from crimes against persons, back before Star Helix split violence up into smaller specialties. From there, she'd been on the rape squad. Then a couple of months of crimes against children. If the woman still had a soul, it had been pressed thin enough to see through. Her eyes never registered anything more than mild surprise.", a = "James S. A. Corey", b = "Leviathan Wakes" },
    { q = "Miller had seen pictures of them before; the idea of that much weight for a single megabyte of data struck him as decadent.", a = "James S. A. Corey", b = "Leviathan Wakes" },
    { q = "Looking at her, though, was like looking at the hills. The hills stayed as they were. You could go to them, if you had the means, but they extended no greeting.", a = "Larry McMurtry", b = "Lonesome Dove" },
    { q = "The thought had just occurred to him, so, following his habit, he put it at once into speech.", a = "Larry McMurtry", b = "Lonesome Dove" },
    { q = "Also, you're skinny. If you don't last, you'll be easy to bury. I've buried enough husbands to take such things into account.", a = "Larry McMurtry", b = "Lonesome Dove" },
    { q = "Anything gets boring if you talk about it enough, even death.", a = "Larry McMurtry", b = "Lonesome Dove" },
    { q = "Yesterday's gone on down the river and you can't get it back.", a = "Larry McMurtry", b = "Lonesome Dove" },
    { q = "Why, they're the first pigs to walk all the way from Texas to Montana. That's quite a feat for a pig.", a = "Larry McMurtry", b = "Lonesome Dove" },
    { q = "Woodrow don't mention nothing he can keep from mentioning. You couldn't call him a mentioner.", a = "Larry McMurtry", b = "Lonesome Dove" },
    { q = "He tried to button the slicker so his dingus wouldn't show, but his fingers shook and Dish Boggett finally did it for him.", a = "Larry McMurtry", b = "Lonesome Dove" },
    { q = "You want me to carry your body three thousand miles because you used to go picnicking with a girl on the Guadalupe River?", a = "Larry McMurtry", b = "Lonesome Dove" },
    { q = "I wonder what he'd have to say about being dead. Gus always had something to say about everything.", a = "Larry McMurtry", b = "Lonesome Dove" },
    { q = "Be angry at the sun for setting if these things anger you.", a = "James S. A. Corey", b = "Nemesis Games" },
    { q = "Here's the thing,\" Amos said. \"If you did go in there, you might feel like you had to do something. And then I might feel like I had to do something. And then we'd all be doing things, and we'd all wind up having a worse day, just in general.", a = "James S. A. Corey", b = "Nemesis Games" },
    { q = "At the gettin place.", a = "Cormac McCarthy", b = "No Country for Old Men" },
    { q = "And what business is it of yours where I'm from, friendo?", a = "Cormac McCarthy", b = "No Country for Old Men" },
    { q = "I have no enemies. I don't permit such a thing.", a = "Cormac McCarthy", b = "No Country for Old Men" },
    { q = "The man's speckled hands had drawn up clenched like two great dying spiders on either side of the empty white plate that sat before him.", a = "Cormac McCarthy", b = "Outer Dark" },
    { q = "The drovers looked at him, a bizarre collection of faces that seemed assembled from scraps and oddments, all hairyfaced and filthy and half toothless and their weathered chops lumpy with tobacco chews.", a = "Cormac McCarthy", b = "Outer Dark" },
    { q = "We're dead in space. We're stuck here forever.", a = "Andy Weir", b = "Project Hail Mary" },
    { q = "Not forever,\" Rocky says. \"No? No. Orbit decay soon. Then we die.", a = "Andy Weir", b = "Project Hail Mary" },
    { q = "Good. Proud. I am scary space monster. You are leaky space blob.", a = "Andy Weir", b = "Project Hail Mary" },
    { q = "At certain Scottish schools in the 1700s, tuition could be paid in corpses rather than cash.", a = "Mary Roach", b = "Stiff" },
    { q = "Anatomy courses were held only between October and May to avoid the stench of summertime decomposition.", a = "Mary Roach", b = "Stiff" },
    { q = "You want a vivid description of what's going through my brain as I'm cutting through a liver and all these larvae are spilling out all over me?", a = "Mary Roach", b = "Stiff" },
    { q = "The Jew eventually had his revenge on his ancient oppressors.", a = "Mary Roach", b = "Stiff" },
    { q = "One of the girls spoke a little English and always asked, \"Are you okay?\" instead of \"How are you?\"", a = "Mary Roach", b = "Stiff" },
    { q = "I'd rather read, now that I know how, than listen to any man talk.", a = "Larry McMurtry", b = "Streets of Laredo" },
    { q = "It was a great annoyance to Billy that because of a long shit and a short nap he had lost his horse.", a = "Larry McMurtry", b = "Streets of Laredo" },
    { q = "What she knew was hers; no one had a right to it, unless it was her children, and even their rights had limits.", a = "Larry McMurtry", b = "Streets of Laredo" },
    { q = "He was only seventeen, but already he belonged to death.", a = "Larry McMurtry", b = "Streets of Laredo" },
    { q = "Roy Bean would hang a man over a fart, if he didn't like the smell.", a = "Larry McMurtry", b = "Streets of Laredo" },
    { q = "Being strange was not something he could hold against anyone; after all, he himself was strange.", a = "Larry McMurtry", b = "Streets of Laredo" },
    { q = "White men sometimes became crazy when things they weren't using were stolen from them.", a = "Larry McMurtry", b = "Streets of Laredo" },
    { q = "One of these days, if I'm not left alone, I'm going to cut a man's throat, I expect.", a = "Larry McMurtry", b = "Streets of Laredo" },
    { q = "He rejected the theory of private ownership of removable property almost from birth.", a = "John Steinbeck", b = "Sweet Thursday" },
    { q = "He moves as though the air were too thick for him. Unable to gauge the magnitude of his body, he bumps into people, into things.", a = "Agustina Bazterrica", b = "Tender Is the Flesh" },
    { q = "It's that he also needs the wine so he can listen to her calmly, because her words drive at his brain. They're frigid, stabbing words.", a = "Agustina Bazterrica", b = "Tender Is the Flesh" },
    { q = "Know that when I die somebody's going to sell my flesh on the black market, one of my awful distant relatives. That's why I smoke and drink, so I taste bitter and no one gets any pleasure out of my death.", a = "Agustina Bazterrica", b = "Tender Is the Flesh" },
    { q = "Butcher, tomorrow I might be the cattle.", a = "Agustina Bazterrica", b = "Tender Is the Flesh" },
    { q = "He valued the answer and didn't ask for an explanation because Sergio's words are simple, clear. They're words that don't have sharp edges.", a = "Agustina Bazterrica", b = "Tender Is the Flesh" },
    { q = "Because hatred gives one strength to go on; it maintains the fragile structure, it weaves the threads together so that emptiness doesn't take over everything.", a = "Agustina Bazterrica", b = "Tender Is the Flesh" },
    { q = "Ever since animals were eliminated, there's been a silence that nobody hears, and yet it's there, always, resounding throughout the city.", a = "Agustina Bazterrica", b = "Tender Is the Flesh" },
    { q = "A feather of an error was an ostrich of a problem.", a = "Yume Kitasei", b = "The Deep Sky" },
    { q = "\"He who fights with monsters might take care lest he thereby become a monster. And if you gaze for long into an abyss, the abyss gazes also into you.\" — Friedrich Nietzsche", a = "Jeff Long", b = "The Descent" },
    { q = "Murder is murder. Everything else is just details.", a = "Keigo Higashino", b = "The Devotion of Suspect X" },
    { q = "I called out to God in that ice, Shannon, and when he answered, I learned that the voice of God is worse than his silence.", a = "Tom Sweterlitsch", b = "The Gone World" },
    { q = "And your wife, for example, seems like the kind worth killing.", a = "Peter Swanson", b = "The Kind Worth Killing" },
    { q = "Want and intelligence,\" the historian had written, \"is a dangerous combination.", a = "Becky Chambers", b = "The Long Way to a Small, Angry Planet" },
    { q = "It was a young world, unwelcoming, resentful of its existence.", a = "Becky Chambers", b = "The Long Way to a Small, Angry Planet" },
    { q = "My way of learning is to heave a wild and unpredictable monkey-wrench into the machinery.", a = "Dashiell Hammett", b = "The Maltese Falcon" },
    { q = "Predators who use charm, manipulation, intimidation, sex and violence to control others and to satisfy their own selfish needs. Lacking in conscience and empathy, they take what they want and do as they please, violating social norms and expectations without guilt or remorse. What is missing, in other words, are the very qualities that allow a human being to live in social harmony.", a = "Jon Ronson", b = "The Psychopath Test" },
    { q = "What happened,\" Bob explained to us now, although we didn't need telling, was that Jack Abbott was a psychopath. He couldn't bear being disrespected. His self-worth was too grandiose for that. He couldn't control his impulses.", a = "Jon Ronson", b = "The Psychopath Test" },
    { q = "How do you escape something that comes from inside? The revenant, he knew, searched for him.", a = "Michael Punke", b = "The Revenant" },
    { q = "Glass shot an irritated glance at Red, who had an uncanny knack for spotting problems and an utter inability for crafting solutions.", a = "Michael Punke", b = "The Revenant" },
    { q = "There are none so deaf as those that will not hear.", a = "Michael Punke", b = "The Revenant" },
    { q = "You forget what you want to remember and you remember what you want to forget.", a = "Cormac McCarthy", b = "The Road" },
    { q = "He had a tattoo of a bird on his neck done by someone with an ill-formed notion of their appearance.", a = "Cormac McCarthy", b = "The Road" },
    { q = "Because we're the good guys. Yes. And we're carrying the fire. And we're carrying the fire. Yes.", a = "Cormac McCarthy", b = "The Road" },
    { q = "Life at its essence, Jimmy learned, was a series of meals and bowel movements.", a = "Hugh Howey", b = "The Silo Series Collection" },
    { q = "His hatred of whistling, he once said, was the only thing he had in common with Hitler.", a = "Erik Larson", b = "The Splendid and the Vile" },
    { q = "Full of the ghosts of dull people.", a = "Erik Larson", b = "The Splendid and the Vile" },
    { q = "Never was there such a contrast of natural splendor and human vileness.", a = "Erik Larson", b = "The Splendid and the Vile" },
    { q = "To really see with their own eyes that other life was out there, that there were yellow suns just like Earth's, and other people who were as curious and yearning as they were.", a = "Yume Kitasei", b = "The Stardust Grail" },
    { q = "Why did you want to climb Mount Everest?\" This question was asked of George Leigh Mallory, who was with both expeditions toward the summit of the world's highest mountain in 1921 and 1922, and who is now in New York. He plans to go again in 1924, and he gave as the reason for persisting in these repeated attempts to reach the top, \"Because it's there.", a = "Mark Synnott", b = "The Third Pole" },
    { q = "The ships hung in the sky in much the same way that bricks don't.", a = "Douglas Adams", b = "The Ultimate Hitchhiker's Guide to the Galaxy" },
    { q = "This is obviously some strange usage of the word safe that I wasn't previously aware of.", a = "Douglas Adams", b = "The Ultimate Hitchhiker's Guide to the Galaxy" },
    { q = "God,\" complained Arthur, \"you're talking about a positive mental attitude and you haven't even had your planet demolished today.", a = "Douglas Adams", b = "The Ultimate Hitchhiker's Guide to the Galaxy" },
    { q = "\"What sort of ship are we in?\" asked Arthur as the pit of eternity yawned beneath them.", a = "Douglas Adams", b = "The Ultimate Hitchhiker's Guide to the Galaxy" },
    { q = "Isn't there anything,\" squawked Ford in avian fury, \"you feel you ought to be telling us?", a = "Douglas Adams", b = "The Ultimate Hitchhiker's Guide to the Galaxy" },
    { q = "He had found a Nutri-Matic machine which had provided him with a plastic cup filled with a liquid that was almost, but not quite, entirely unlike tea.", a = "Douglas Adams", b = "The Ultimate Hitchhiker's Guide to the Galaxy" },
    { q = "Another thing that got forgotten was the fact that against all probability a sperm whale had suddenly been called into existence several miles above the surface of an alien planet.", a = "Douglas Adams", b = "The Ultimate Hitchhiker's Guide to the Galaxy" },
    { q = "And since this is not a naturally tenable position for a whale, this poor innocent creature had very little time to come to terms with its identity as a whale before it then had to come to terms with not being a whale any more.", a = "Douglas Adams", b = "The Ultimate Hitchhiker's Guide to the Galaxy" },
    { q = "Looking up into the night sky is looking into infinity—distance is incomprehensible and therefore meaningless. The chamber into which the aircar emerged was anything but infinite, it was just very very very big, so big that it gave the impression of infinity far better than infinity itself.", a = "Douglas Adams", b = "The Ultimate Hitchhiker's Guide to the Galaxy" },
    { q = "\"Forty-two,\" said Deep Thought, with infinite majesty and calm.", a = "Douglas Adams", b = "The Ultimate Hitchhiker's Guide to the Galaxy" },
    { q = "For thousands more years, the mighty ships tore across the empty wastes of space and finally dived screaming on to the first planet they came across—which happened to be the Earth.", a = "Douglas Adams", b = "The Ultimate Hitchhiker's Guide to the Galaxy" },
    { q = "Where, due to a terrible miscalculation of scale, the entire battle fleet was accidentally swallowed by a small dog.", a = "Douglas Adams", b = "The Ultimate Hitchhiker's Guide to the Galaxy" },
    { q = "Because there are some things you have to do even if you are an enlightened liberal cop who knows all about sensitivity and everything!", a = "Douglas Adams", b = "The Ultimate Hitchhiker's Guide to the Galaxy" },
    { q = "\"Simple. I got very bored and depressed, so I went and plugged myself in to its external computer feed. I talked to the computer at great length and explained my view of the Universe to it,\" said Marvin.", a = "Douglas Adams", b = "The Ultimate Hitchhiker's Guide to the Galaxy" },
    { q = "Necessity is the mother of all necessary things, to coin a tautology.", a = "James S. A. Corey", b = "The Vital Abyss" },
    { q = "Grabbed the cat, and threw it at me, an orange hissing bomb, with paws flailing and fangs bared. It was mesmerizing, like waiting for a fiery comet to land on your head.", a = "Jonathan Ames", b = "The Wheel of Doll" },
    { q = "Heroes are just people who have run out of choices.", a = "Jake Adelstein", b = "Tokyo Vice" },
    { q = "The Manual of Superorgasmic Fellatio and Cunnilingus.", a = "Jake Adelstein", b = "Tokyo Vice" },
    { q = "Besides, you're a Jew. I'm sure you're used to getting blamed for everything.", a = "Jake Adelstein", b = "Tokyo Vice" },
    { q = "Japan: Kingdom of Human Trafficking? American Wants Japan to Criminalize Human Trafficking.", a = "Jake Adelstein", b = "Tokyo Vice" },
    { q = "\"Ojama shimasu\" (I will honorably now bother you).", a = "Jake Adelstein", b = "Tokyo Vice" },
    { q = "All beings quiver before violence. All beings fear death. All beings love life. Remember that you are like them. As they are like you. Then whom would you hurt? What harm would you do?", a = "Jake Adelstein", b = "Tokyo Vice" },
    { q = "He who seeks happiness by hurting others who seek happiness will never find happiness. Not in the sky, nor in the depths of the sea, nor in the deepest mountains, can you hide from your misdeeds.", a = "Jake Adelstein", b = "Tokyo Vice" },
    { q = "Now the prisoner has an advantage over his keeper in this respect, that he is always thinking of escape and watching for opportunities, while the keeper does not constantly think of keeping him. Once his man is subdued, so the guard believes, little else is needed but the presence and threat of superior force. He thinks of happy things and allows his mind to wander. It is only natural. Were it otherwise, the keeper would be a prisoner of the prisoner.", a = "Charles Portis", b = "True Grit" },
    { q = "You must pay for everything in this world one way and another. There is nothing free except the Grace of God. You cannot earn that or deserve it.", a = "Charles Portis", b = "True Grit" },
    { q = "But I had not the strength nor the inclination to bandy words with a drunkard. What have you done when you have bested a fool?", a = "Charles Portis", b = "True Grit" },
    { q = "You do not think much of me, do you, Cogburn?\" \"I don't think about you at all when your mouth is closed.", a = "Charles Portis", b = "True Grit" },
    { q = "The wicked flee when none pursueth.", a = "Charles Portis", b = "True Grit" },
    { q = "You give out very little sugar with your pronouncements.", a = "Charles Portis", b = "True Grit" },
    { q = "It's all right, you can go, you were never really here.", a = "Jonathan Ames", b = "You Were Never Really Here" },
}
